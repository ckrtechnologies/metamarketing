PORT=5001

# Meta App Credentials
FB_APP_ID=your_meta_app_id
FB_APP_SECRET=your_meta_app_secret

# Facebook Page Config
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_permanent_page_access_token

# Instagram Business Account Config
IG_USER_ID=your_instagram_business_user_id
IG_USERNAME=your_instagram_username

# Uploads
UPLOAD_DIR=uploads

# ── WhatsApp Business Cloud API (Mode B — optional) ──────────────
# Only needed if you want to use Cloud API mode (send without opening WhatsApp manually).
# wa.me deep link mode (Mode A) works without any of these.
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
